{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://starbucks-coffe.runasp.net/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "http://starbucks-coffe.runasp.net/health/:path*"
    },
    {
      "source": "/orderHub",
      "destination": "http://starbucks-coffe.runasp.net/orderHub"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
