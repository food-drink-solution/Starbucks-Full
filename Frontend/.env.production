# API Configuration
VITE_API_URL=https://starbucks.runasp.net/api

# Google OAuth (Production)
# Replace with your actual credentials from Google Cloud Console
VITE_GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
VITE_GOOGLE_OAUTH_REDIRECT_URI=https://starbucks.eg/auth/google/callback

# Environment
VITE_NODE_ENV=production

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# External Services
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
VITE_PAYMOB_IFRAME_BASE=https://accept.paymob.com/api/acceptance/iframes
VITE_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE
VITE_SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# App Configuration
VITE_APP_NAME="Starbucks Egypt"
VITE_APP_VERSION=2.1.0
VITE_DEFAULT_LANGUAGE=ar

# Cache Configuration
VITE_CACHE_VERSION=1
VITE_ENABLE_SERVICE_WORKER=true

# Production
VITE_MOCK_API=false
VITE_DEBUG_MODE=false